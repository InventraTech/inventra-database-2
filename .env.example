# Copie para .env e preencha. O .env real nunca é versionado.

# PostgreSQL: seed (postgre/seeds/seed.ipynb) e scripts de backup (postgre/backup/*.sh).
# O seed do MongoDB também lê tb_user daqui para usar user_id reais.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventra_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSLMODE=prefer

# MongoDB da IA: migrations (mongo/migrations) e seed (mongo/seeds/seed.ipynb).
MONGO_CONNECTION=mongodb://localhost:27017
MONGO_DB=dbIAI

# Neo4j: reprojeção do grafo de cobertura de fornecedores (neo4j/seeds/seed.ipynb).
# Também lê as variáveis DB_* acima, porque o grafo é projetado a partir do PostgreSQL.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
